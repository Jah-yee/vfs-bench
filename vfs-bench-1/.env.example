# Copy to .env.development and fill in. Never commit the filled-in file.

# --- model gateway -----------------------------------------------------
# Infron gateway (OpenAI Chat Completions compatible).
INFRON_API_KEY=sk-...

# Claude models (`--model anthropic/<model>`), asked on Anthropic's own API:
# `--base-url https://api.anthropic.com --api-key-env ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=

# Original Toolathlon web search: use an API key from serper.dev.
SERPER_API_KEY=

# Live Google Workspace OAuth. Keep the real values only in
# .env.development and in the ignored authorized-user JSON named below.
# Enable the Drive and Google Forms APIs in the OAuth client's Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=state/credentials/google_credentials.json

# The original Google Maps MCP requires a separate Maps Platform API key;
# the Workspace OAuth values above cannot replace it.
GOOGLE_MAPS_API_KEY=

# The original YouTube MCP requires a YouTube Data API v3 key.
YOUTUBE_API_KEY=

# What Toolathlon's `unified` provider reads. Use the model gateway above.
TOOLATHLON_OPENAI_BASE_URL=https://llm.onerouter.pro/v1
TOOLATHLON_OPENAI_API_KEY=sk-...

# --- the fixture stack --------------------------------------------------
# Every fake both arms talk to runs in docker/compose.yml. `bin/start.sh up`
# starts it and `bin/start.sh env` prints exactly this block back with
# whatever ports it actually bound, so these are defaults rather than
# settings -- change one only to move a port.
#
# The benchmark itself is not in there: mirage, the agent loop, the mirage
# CLIs and the evaluator all run on the host and reach the fakes here.

# Mock Google Workspace: Drive, Sheets, Docs, Slides, Gmail, Calendar, Forms.
GWS_URL=http://127.0.0.1:19999
GWS_PORT=19999

# Fixture API: per-task state at /api/<task>/<service>, Cloud Logging today.
# /stack/healthz on this port reports every service in the stack at once.
API_URL=http://127.0.0.1:9110
API_PORT=9110

# Fake Notion REST API (Prisma + SQLite, recreated on every start).
NOTION_URL=http://127.0.0.1:5091
NOTION_PORT=5091

# Fake GitHub. A task hands it its own repositories by writing a fixture
# into the assembled root and asking for it by name; server/fakes/github.py
# is the client side of that.
GITHUB_URL=http://127.0.0.1:19801
GITHUB_PORT=19801

# Fake Hugging Face Hub, on two ports: the REST surface both arms reach --
# HF_ENDPOINT is huggingface_hub's own variable, so setting it redirects the
# MCP arm's python as well as the mirage arm's mount -- and the MCP one the
# arm's `mcp-remote` bridge points at instead of huggingface.co/mcp.
HF_ENDPOINT=http://127.0.0.1:5199
HF_HUB_PORT=5199
HF_MCP_URL=http://127.0.0.1:5200/mcp
HF_MCP_PORT=5200

# The fixture Postgres: yfinance rows both arms read, and the database the
# google_sheet shim writes through.
YF_DSN=postgresql://eigent:camel@localhost:5433/vfs_bench
PG_PORT=5433

# GreenMail, for the eleven email tasks.
MAIL_IMAP_PORT=1143
MAIL_SMTP_PORT=1587
MAIL_API_PORT=8081

# BigQuery and Cloud Storage are per task and opt-in: `uv run python
# server/fakes/gcp.py <task>` brings them up on the four ports below and
# writes the seed's own record, out of which `bin/start.sh env` exports the
# frozen BQ_LAUNCH_TIME the evaluator has to be handed.
BQ_PORT=9050
BQ_PROXY_PORT=9051
GCP_TOKEN_PORT=9061
GCS_PORT=9070

# --- external checkouts ------------------------------------------------
# Deliberately unset. All three are git submodules under `submodule/`, and
# the code defaults to exactly that, so a fresh checkout needs nothing here.
# They were once set to `./Toolathlon` and `./vendor/mirage`, which is where
# the submodules used to live -- and because `run_agent.py` loads this file
# into the environment, a stale value here does not read as an out-of-date
# default, it *overrides* the correct one. Set one only to point somewhere
# else on purpose:
#   TOOLATHLON_ROOT      -- task, prompts, evaluator, local tools
#   TOOLATHLON_GYM_ROOT  -- the vendored filesystem and terminal MCP servers
#   MIRAGE_PACKAGES      -- the built mirage TypeScript packages the daemon runs


# --- task runtime ------------------------------------------------------
# Drive folder id the mock seeds; see seed_mock.py output.
DRIVE_FOLDER_ID=f0001

# Kubernetes tasks create and delete an E2B sandbox for each arm.
E2B_API_KEY=

# --- MCP-Atlas ---------------------------------------------------------
# Keys the pinned Atlas servers read, under the names Atlas's own
# mcp_server_template.json gives them. Both arms run the same server, so a
# missing key is missing on both. slack, notion, airtable, google-workspace
# and most github tasks read local fakes and need nothing here.

# github: https://github.com/settings/tokens (public-repo read is enough).
# The four Atlas tasks in `GITHUB_LIVE` (task/mcpatlas/__init__.py) read
# live GitHub on it, and
# Toolathlon's git-milestone grader refetches api.github.com with it; unset,
# that grader falls back to the task's committed before_task.json.
GITHUB_TOKEN=

# national-parks: https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# oxylabs: a Web Scraper API user from https://dashboard.oxylabs.io/
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# exa: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# wikipedia: an owner-only OAuth 2 access token, from
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# with "This consumer is for use only by <you>" ticked.
WIKIPEDIA_ACCESS_TOKEN=

# google-maps reads GOOGLE_MAPS_API_KEY, set above for Toolathlon's server.

# weather-data: https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=

# Shared /work files for native E2B execution. Use a dedicated bucket prefix.
BENCH_S3_BUCKET=
BENCH_S3_PREFIX=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional S3-compatible endpoint:
# AWS_ENDPOINT_URL_S3=
