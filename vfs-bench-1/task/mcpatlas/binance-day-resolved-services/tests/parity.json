{
 "note": "Both arms read one tree at one path -- the MCP arm's servers read the image's own /data in the run's container, and the mirage /data mount is a copy of it taken out of the same image. Notion is the fake both arms read, seeded per run from Atlas's export.",
 "cases": [
  {
   "name": "may_requests",
   "why": "the same service requests in May 2017",
   "mcp": {
    "server": "notion",
    "tool": "API-post-database-query",
    "args": {
     "database_id": "21b97551-844e-808d-a0c5-ed2d08f39729",
     "filter": {
      "and": [
       {
        "property": "InteractionDate",
        "date": {
         "on_or_after": "2017-05-01"
        }
       },
       {
        "property": "InteractionDate",
        "date": {
         "before": "2017-06-01"
        }
       }
      ]
     },
     "page_size": 20
    },
    "pipe": "jq -r '.results[].id'"
   },
   "mirage": {
    "command": "notion post-database-query '{\"database_id\": \"21b97551-844e-808d-a0c5-ed2d08f39729\", \"filter\": {\"and\": [{\"property\": \"InteractionDate\", \"date\": {\"on_or_after\": \"2017-05-01\"}}, {\"property\": \"InteractionDate\", \"date\": {\"before\": \"2017-06-01\"}}]}, \"page_size\": 20}'",
    "pipe": "jq -r '.results[].id'"
   }
  },
  {
   "name": "row_count",
   "why": "the same file has the same length, so a mean taken over it has the same denominator",
   "mcp": {
    "server": "filesystem",
    "tool": "get_file_info",
    "args": {
     "path": "/data/fantasy sports.csv"
    },
    "pipe": "sed -n 's/^size: //p'"
   },
   "mirage": {
    "command": "wc -c < '/data/fantasy sports.csv'",
    "pipe": "tr -d ' '"
   }
  },
  {
   "name": "list_directory",
   "why": "both arms see the same tree -- the eight CSVs and the repos/ directory",
   "mcp": {
    "server": "filesystem",
    "tool": "list_directory",
    "args": {
     "path": "/data"
    },
    "pipe": "sed -n 's/^\\[FILE\\] //p; s/^\\[DIR\\] //p' | sort"
   },
   "mirage": {
    "command": "ls /data",
    "pipe": "sort"
   }
  },
  {
   "name": "meal",
   "why": "the same meal on the day of the fourth",
   "mcp": {
    "server": "filesystem",
    "tool": "read_text_file",
    "args": {
     "path": "/data/food and beverage consumption.csv"
    },
    "pipe": "grep '17 Jun 2023'"
   },
   "mirage": {
    "command": "grep '17 Jun 2023' '/data/food and beverage consumption.csv'"
   }
  },
  {
   "name": "read_graph",
   "why": "the memory CLI is the MCP arm's memory server over the same graph file",
   "mcp": {
    "server": "memory",
    "tool": "read_graph",
    "args": {},
    "pipe": "jq -r '.entities[].name' | sort"
   },
   "mirage": {
    "command": "memory read-graph '{}'",
    "pipe": "jq -r '.entities[].name' | sort"
   }
  }
 ]
}
