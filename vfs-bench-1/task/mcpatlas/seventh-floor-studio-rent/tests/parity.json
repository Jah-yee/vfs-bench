{
  "note": "Both arms read one tree at one path -- the MCP arm's servers read the image's own /data in the run's container, and the mirage /data mount is a copy of it taken out of the same image -- and one Notion and one Slack, the fakes this run starts, seeded from Atlas's exports. Live services Atlas enables beside the task have no reply case: `map` checks that each CLI is the server's own tool, schema for schema, and a live reply is not the same twice.",
  "cases": [
    {
      "name": "list_directory",
      "why": "both arms see the same tree -- the eight CSVs and the repos/ directory",
      "mcp": {
        "server": "filesystem",
        "tool": "list_directory",
        "args": {
          "path": "/data"
        },
        "pipe": "sed -n 's/^\\[FILE\\] //p; s/^\\[DIR\\] //p' | sort"
      },
      "mirage": {
        "command": "ls /data",
        "pipe": "sort"
      }
    },
    {
      "name": "profits",
      "why": "the same weekly profits",
      "mcp": {
        "server": "filesystem",
        "tool": "read_file",
        "args": {
          "path": "/data/Pet Care 2023 Weekly Financials.csv"
        },
        "pipe": "grep 'Week'"
      },
      "mirage": {
        "command": "grep 'Week' '/data/Pet Care 2023 Weekly Financials.csv'"
      }
    },
    {
      "name": "cheapest",
      "why": "the same cheapest two-room, unfurnished apartments on the seventh floor or above",
      "mcp": {
        "server": "notion",
        "tool": "API-post-database-query",
        "args": {
          "database_id": "21b97551-844e-8090-b48d-d33c1c2be7f8",
          "filter": {
            "and": [
              {
                "property": "Bedrooms",
                "number": {
                  "equals": 2
                }
              },
              {
                "property": "Floor",
                "number": {
                  "greater_than_or_equal_to": 7
                }
              },
              {
                "property": "FurnishingStatus",
                "select": {
                  "equals": "Unfurnished"
                }
              }
            ]
          },
          "page_size": 3,
          "sorts": [
            {
              "property": "MonthlyRent",
              "direction": "ascending"
            }
          ]
        },
        "pipe": "jq -r '.results[].id'"
      },
      "mirage": {
        "command": "notion post-database-query '{\"database_id\": \"21b97551-844e-8090-b48d-d33c1c2be7f8\", \"filter\": {\"and\": [{\"property\": \"Bedrooms\", \"number\": {\"equals\": 2}}, {\"property\": \"Floor\", \"number\": {\"greater_than_or_equal_to\": 7}}, {\"property\": \"FurnishingStatus\", \"select\": {\"equals\": \"Unfurnished\"}}]}, \"page_size\": 3, \"sorts\": [{\"property\": \"MonthlyRent\", \"direction\": \"ascending\"}]}'",
        "pipe": "jq -r '.results[].id'"
      }
    }
  ]
}
