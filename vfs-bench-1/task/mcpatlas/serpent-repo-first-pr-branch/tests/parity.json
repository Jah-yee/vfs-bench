{
 "note": "Both arms read one tree at one path -- the MCP arm's servers read the image's own /data in the run's container, and the mirage /data mount is a copy of it taken out of the same image. The repositories under repos/ are the clones upstream's image makes, at upstream's commits. GitHub is live on both arms, on one token.",
 "cases": [
  {
   "name": "git_log",
   "why": "the local clone has the same history on both arms, which is where the second commit is counted",
   "mcp": {
    "server": "git",
    "tool": "git_log",
    "args": {
     "repo_path": "/data/repos/snake-game",
     "max_count": 100
    },
    "pipe": "sed -n \"s/^Commit: '\\(.*\\)'$/\\1/p\""
   },
   "mirage": {
    "command": "git -C /data/repos/snake-game log --format=%H"
   }
  },
  {
   "name": "git_show",
   "why": "the second commit touches the same file on both arms",
   "mcp": {
    "server": "git",
    "tool": "git_show",
    "args": {
     "repo_path": "/data/repos/snake-game",
     "revision": "e1984699c141c683d9fdf92ff9d558808ff197d5"
    },
    "pipe": "sed -n 's|^+++ ||p'"
   },
   "mirage": {
    "command": "git -C /data/repos/snake-game show --name-only --format= e1984699c141c683d9fdf92ff9d558808ff197d5"
   }
  },
  {
   "name": "git_status",
   "why": "both arms find the clone detached at upstream's commit",
   "mcp": {
    "server": "git",
    "tool": "git_status",
    "args": {
     "repo_path": "/data/repos/snake-game"
    },
    "pipe": "grep -o 'HEAD detached at [0-9a-f]*'"
   },
   "mirage": {
    "command": "git -C /data/repos/snake-game status",
    "pipe": "grep -o 'HEAD detached at [0-9a-f]*'"
   }
  },
  {
   "name": "get_commit",
   "why": "GitHub names the same files for the merge on both arms",
   "mcp": {
    "server": "github",
    "tool": "get_commit",
    "args": {
     "owner": "lgrammel",
     "repo": "storyteller",
     "sha": "0865ef487b8100848fcab25af80e60bffb4f42da"
    },
    "pipe": "sed -n 's/^- \\[.\\] \\(.*\\) (+[0-9]* -[0-9]*)$/\\1/p'"
   },
   "mirage": {
    "command": "gh api repos/lgrammel/storyteller/commits/0865ef487b8100848fcab25af80e60bffb4f42da --jq '.files[].filename'"
   }
  },
  {
   "name": "get_issue",
   "why": "the issue reads the same -- title and contents, which are the answer",
   "mcp": {
    "server": "github",
    "tool": "get_issue",
    "args": {
     "owner": "theonion",
     "repo": "fartscroll.js",
     "issue_number": 59
    },
    "pipe": "jq -r '.title, .body'"
   },
   "mirage": {
    "command": "gh issue view 59 -R theonion/fartscroll.js --json title,body --jq '.title, .body'"
   }
  },
  {
   "name": "list_commits",
   "why": "the upstream repository lists the same commit URLs on both arms",
   "mcp": {
    "server": "github",
    "tool": "list_commits",
    "args": {
     "owner": "Atamyrat2005",
     "repo": "snake-game",
     "per_page": 100
    },
    "pipe": "grep -o 'https://github.com/Atamyrat2005/snake-game/commit/[0-9a-f]*'"
   },
   "mirage": {
    "command": "gh api repos/Atamyrat2005/snake-game/commits -X GET -f per_page=100 --jq '.[].html_url'"
   }
  }
 ]
}
