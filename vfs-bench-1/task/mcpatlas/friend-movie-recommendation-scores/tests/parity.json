{
  "note": "Both arms read one tree at one path -- the MCP arm's servers read the image's own /data in the run's container, and the mirage /data mount is a copy of it taken out of the same image. GitHub is mirage's GitHub fake on both arms, and it holds nothing. Slack is the fake both arms read, seeded per run from Atlas's export. Airtable is the fake both arms read, seeded per run with the base Atlas shares in place of an export.",
  "cases": [
    {
      "name": "list_directory",
      "why": "both arms see the same tree -- the eight CSVs and the repos/ directory",
      "mcp": {
        "server": "filesystem",
        "tool": "list_directory",
        "args": {
          "path": "/data"
        },
        "pipe": "sed -n 's/^\\[FILE\\] //p; s/^\\[DIR\\] //p' | sort"
      },
      "mirage": {
        "command": "ls /data",
        "pipe": "sort"
      }
    },
    {
      "name": "consumption",
      "why": "the same survey rows, by age group",
      "mcp": {
        "server": "filesystem",
        "tool": "read_file",
        "args": {
          "path": "/data/food and beverage consumption.csv"
        },
        "pipe": "grep '18-24'"
      },
      "mirage": {
        "command": "grep '18-24' '/data/food and beverage consumption.csv'"
      }
    },
    {
      "name": "meal",
      "why": "the same meal on the day of the fourth",
      "mcp": {
        "server": "filesystem",
        "tool": "read_text_file",
        "args": {
          "path": "/data/food and beverage consumption.csv"
        },
        "pipe": "grep '17 Jun 2023'"
      },
      "mirage": {
        "command": "grep '17 Jun 2023' '/data/food and beverage consumption.csv'"
      }
    },
    {
      "name": "channels_list",
      "why": "both arms list the same six channels of the same workspace",
      "mcp": {
        "server": "slack",
        "tool": "channels_list",
        "args": {
          "channel_types": "public_channel,private_channel"
        },
        "pipe": "sed 1d | cut -d, -f1 | sort"
      },
      "mirage": {
        "command": "ls /slack/channels",
        "pipe": "sed 's/.*__//' | sort"
      }
    },
    {
      "name": "conversations_history",
      "why": "both arms read every message of #movie-suggestions, joins and leaves included, at the same timestamps",
      "mcp": {
        "server": "slack",
        "tool": "conversations_history",
        "args": {
          "channel_id": "C093FF10B5J",
          "limit": "100",
          "include_activity_messages": true
        },
        "pipe": "grep -o '17[0-9]\\{8\\}\\.[0-9]\\{6\\}' | sort"
      },
      "mirage": {
        "command": "cat /slack/channels/movie-suggestions__C093FF10B5J/*/chat.jsonl",
        "pipe": "jq -r .ts | sort"
      }
    },
    {
      "name": "list_bases",
      "why": "the same one base",
      "mcp": {
        "server": "airtable",
        "tool": "list_bases",
        "args": {},
        "pipe": "jq -r '.[] | .id + \" \" + .name + \" \" + .permissionLevel' | grep ."
      },
      "mirage": {
        "command": "jq -r '.base_id + \" \" + .base_name + \" \" + .permission_level' /airtable/bases/Car_Dealership__appIF9byLfQwdHqE2/base.json",
        "pipe": "grep ."
      }
    }
  ]
}
