{
  "note": "Tool-command cases call the same pinned handler down both arms, over the same fixture, so the replies are compared whole; a bespoke CLI answers in its own shape and is projected onto the same fact.",
  "cases": [
    {
      "name": "rail_12306_get_current_date",
      "why": "both arms report the same date",
      "mcp": {
        "server": "rail_12306",
        "tool": "get-current-date",
        "args": {}
      },
      "mirage": {
        "command": "rail-12306 get-current-date"
      }
    },
    {
      "name": "rail_12306_get_stations_code_in_city",
      "why": "the same station table for one city",
      "mcp": {
        "server": "rail_12306",
        "tool": "get-stations-code-in-city",
        "args": {
          "city": "北京"
        }
      },
      "mirage": {
        "command": "rail-12306 get-stations-code-in-city '{\"city\":\"北京\"}'"
      }
    },
    {
      "name": "rail_12306_get_station_code_by_names",
      "why": "the same station code",
      "mcp": {
        "server": "rail_12306",
        "tool": "get-station-code-by-names",
        "args": {
          "stationNames": "北京南"
        }
      },
      "mirage": {
        "command": "rail-12306 get-station-code-by-names '{\"stationNames\":\"北京南\"}'"
      }
    },
    {
      "name": "fetch_fetch_html",
      "why": "the raw body is identical through either arm",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_html",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "fetch html '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "fetch_fetch_txt",
      "why": "markup stripping agrees",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_txt",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "fetch txt '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "fetch_fetch_markdown",
      "why": "markdown conversion agrees",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_markdown",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "fetch markdown '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "fetch_fetch_json",
      "why": "the same URL parses to the same document",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_json",
        "args": {
          "url": "https://api.github.com/repos/mojombo/grit"
        }
      },
      "mirage": {
        "command": "fetch json '{\"url\":\"https://api.github.com/repos/mojombo/grit\"}'"
      }
    }
  ]
}
