{
  "note": "Tool-command cases call the same pinned handler down both arms, over the same fixture, so the replies are compared whole; a bespoke CLI answers in its own shape and is projected onto the same fact.",
  "cases": [
    {
      "name": "woocommerce_products_list",
      "why": "the same first page of products",
      "mcp": {
        "server": "woocommerce",
        "tool": "woo_products_list",
        "args": {
          "perPage": 5
        },
        "pipe": "grep -E '^ {4}\"(id|name|status|price)\": '"
      },
      "mirage": {
        "command": "woocommerce products-list '{\"perPage\":5}' | grep -E '^ {4}\"(id|name|status|price)\": '"
      }
    },
    {
      "name": "woocommerce_products_categories_list",
      "why": "the same categories",
      "mcp": {
        "server": "woocommerce",
        "tool": "woo_products_categories_list",
        "args": {}
      },
      "mirage": {
        "command": "woocommerce products-categories-list"
      }
    },
    {
      "name": "woocommerce_orders_list",
      "why": "the same first page of orders",
      "mcp": {
        "server": "woocommerce",
        "tool": "woo_orders_list",
        "args": {
          "perPage": 5
        },
        "jq": "[.[] | {id, status, total}]"
      },
      "mirage": {
        "command": "woocommerce orders-list '{\"perPage\":5}' | jq -c '[.[] | {id, status, total}]'"
      }
    },
    {
      "name": "woocommerce_customers_list",
      "why": "the same first page of customers",
      "mcp": {
        "server": "woocommerce",
        "tool": "woo_customers_list",
        "args": {
          "perPage": 5
        },
        "jq": "[.[] | {id, email}]"
      },
      "mirage": {
        "command": "woocommerce customers-list '{\"perPage\":5}' | jq -c '[.[] | {id, email}]'"
      }
    },
    {
      "name": "woocommerce_products_get",
      "why": "one product reads back the same",
      "mcp": {
        "server": "woocommerce",
        "tool": "woo_products_get",
        "args": {
          "productId": 21
        },
        "pipe": "grep -E '^ {2}\"(id|name|sku|status|price|stock_status)\": '"
      },
      "mirage": {
        "command": "woocommerce products-get '{\"productId\":21}' | grep -E '^ {2}\"(id|name|sku|status|price|stock_status)\": '"
      }
    },
    {
      "name": "google_sheet_list_folders",
      "why": "both arms see the same Drive folders",
      "mcp": {
        "server": "google_sheet",
        "tool": "list_folders",
        "args": {}
      },
      "mirage": {
        "command": "google-sheet list-folders"
      }
    },
    {
      "name": "google_sheet_list_spreadsheets",
      "why": "the same spreadsheets with the same ids",
      "mcp": {
        "server": "google_sheet",
        "tool": "list_spreadsheets",
        "args": {}
      },
      "mirage": {
        "command": "google-sheet list-spreadsheets"
      }
    },
    {
      "name": "emails_get_folders",
      "why": "both arms list the same IMAP folders",
      "mcp": {
        "server": "emails",
        "tool": "get_folders",
        "args": {}
      },
      "mirage": {
        "command": "emails get-folders"
      }
    },
    {
      "name": "emails_get_emails",
      "why": "the same messages, in the same order, through either arm",
      "mcp": {
        "server": "emails",
        "tool": "get_emails",
        "args": {
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails get-emails '{\"folder\":\"INBOX\"}'"
      }
    },
    {
      "name": "emails_get_unread_count",
      "why": "the unread count agrees",
      "mcp": {
        "server": "emails",
        "tool": "get_unread_count",
        "args": {}
      },
      "mirage": {
        "command": "emails get-unread-count"
      }
    },
    {
      "name": "emails_get_mailbox_stats",
      "why": "the mailbox statistics agree",
      "mcp": {
        "server": "emails",
        "tool": "get_mailbox_stats",
        "args": {}
      },
      "mirage": {
        "command": "emails get-mailbox-stats"
      }
    },
    {
      "name": "emails_search_emails",
      "why": "a search returns the same hits",
      "mcp": {
        "server": "emails",
        "tool": "search_emails",
        "args": {
          "query": "the",
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails search-emails '{\"query\":\"the\",\"folder\":\"INBOX\"}'"
      }
    },
    {
      "name": "google_sheet_list_sheets",
      "why": "the tab list agrees",
      "mcp": {
        "server": "google_sheet",
        "tool": "list_sheets",
        "args": {
          "spreadsheet_id": "f0002"
        }
      },
      "mirage": {
        "command": "google-sheet list-sheets '{\"spreadsheet_id\":\"f0002\"}'"
      }
    },
    {
      "name": "google_sheet_get_sheet_data",
      "why": "the cells read back identically",
      "mcp": {
        "server": "google_sheet",
        "tool": "get_sheet_data",
        "args": {
          "spreadsheet_id": "f0002",
          "sheet": "stock_sheet",
          "range": "A1:C3"
        }
      },
      "mirage": {
        "command": "google-sheet get-sheet-data '{\"spreadsheet_id\":\"f0002\",\"sheet\":\"stock_sheet\",\"range\":\"A1:C3\"}'"
      }
    },
    {
      "name": "google_sheet_update_cells",
      "why": "a write through either arm lands in the same cells",
      "mcp": {
        "server": "google_sheet",
        "tool": "update_cells",
        "args": {
          "spreadsheet_id": "f0002",
          "sheet": "stock_sheet",
          "range": "H1:I2",
          "data": [
            [
              "parity",
              "check"
            ],
            [
              "second",
              "row"
            ]
          ]
        }
      },
      "mirage": {
        "command": "google-sheet update-cells '{\"spreadsheet_id\":\"f0002\",\"sheet\":\"stock_sheet\",\"range\":\"H1:I2\",\"data\":[[\"parity\",\"check\"],[\"second\",\"row\"]]}'"
      },
      "mutates": [
        "gws"
      ]
    }
  ]
}
