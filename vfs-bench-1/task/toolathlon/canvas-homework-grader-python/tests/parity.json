{
  "note": "Tool-command cases call the same pinned handler down both arms, over the same fixture, so the replies are compared whole; a bespoke CLI answers in its own shape and is projected onto the same fact.",
  "cases": [
    {
      "name": "canvas_list_courses",
      "why": "the same courses",
      "mcp": {
        "server": "canvas",
        "tool": "canvas_list_courses",
        "args": {}
      },
      "mirage": {
        "command": "canvas list-courses"
      }
    },
    {
      "name": "canvas_get_user_profile",
      "why": "the same identity",
      "mcp": {
        "server": "canvas",
        "tool": "canvas_get_user_profile",
        "args": {}
      },
      "mirage": {
        "command": "canvas get-user-profile"
      }
    },
    {
      "name": "canvas_get_course",
      "why": "one course reads back the same",
      "mcp": {
        "server": "canvas",
        "tool": "canvas_get_course",
        "args": {
          "course_id": 1
        }
      },
      "mirage": {
        "command": "canvas get-course '{\"course_id\":1}'"
      }
    },
    {
      "name": "canvas_list_assignments",
      "why": "the same assignments",
      "mcp": {
        "server": "canvas",
        "tool": "canvas_list_assignments",
        "args": {
          "course_id": 1
        }
      },
      "mirage": {
        "command": "canvas list-assignments '{\"course_id\":1}'"
      }
    },
    {
      "name": "canvas_list_announcements",
      "why": "the same announcements",
      "mcp": {
        "server": "canvas",
        "tool": "canvas_list_announcements",
        "args": {
          "course_id": 1
        }
      },
      "mirage": {
        "command": "canvas list-announcements '{\"course_id\":1}'"
      }
    },
    {
      "name": "emails_get_folders",
      "why": "both arms list the same IMAP folders",
      "mcp": {
        "server": "emails",
        "tool": "get_folders",
        "args": {}
      },
      "mirage": {
        "command": "emails get-folders"
      }
    },
    {
      "name": "emails_get_emails",
      "why": "the same messages, in the same order, through either arm",
      "mcp": {
        "server": "emails",
        "tool": "get_emails",
        "args": {
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails get-emails '{\"folder\":\"INBOX\"}'"
      }
    },
    {
      "name": "emails_get_unread_count",
      "why": "the unread count agrees",
      "mcp": {
        "server": "emails",
        "tool": "get_unread_count",
        "args": {}
      },
      "mirage": {
        "command": "emails get-unread-count"
      }
    },
    {
      "name": "emails_get_mailbox_stats",
      "why": "the mailbox statistics agree",
      "mcp": {
        "server": "emails",
        "tool": "get_mailbox_stats",
        "args": {}
      },
      "mirage": {
        "command": "emails get-mailbox-stats"
      }
    },
    {
      "name": "emails_search_emails",
      "why": "a search returns the same hits",
      "mcp": {
        "server": "emails",
        "tool": "search_emails",
        "args": {
          "query": "the",
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails search-emails '{\"query\":\"the\",\"folder\":\"INBOX\"}'"
      }
    }
  ]
}
