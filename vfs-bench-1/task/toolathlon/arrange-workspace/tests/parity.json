          "sheet_name": "Sheet1",
          "start_cell": "A1",
          "end_cell": "C5"
        }
      },
      "mirage": {
        "command": "excel read-data-from-excel '{\"filepath\": \"/workspace/exam.xlsx\", \"sheet_name\": \"Sheet1\", \"start_cell\": \"A1\", \"end_cell\": \"C5\"}'"
      }
