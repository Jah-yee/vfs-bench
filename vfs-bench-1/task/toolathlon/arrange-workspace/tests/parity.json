{
  "cases": [
    {
      "name": "read_pdf_pages",
      "why": "The original handler reads the same upstream file through both surfaces.",
      "mcp": {
        "server": "pdf-tools",
        "tool": "read_pdf_pages",
        "args": {
          "pdf_file_path": "${AGENT_WORKSPACE}/cv-gboeing.pdf",
          "start_page": 1,
          "end_page": 3
        }
      },
      "mirage": {
        "command": "pdf-tools read-pdf-pages '{\"pdf_file_path\": \"/workspace/cv-gboeing.pdf\", \"start_page\": 1, \"end_page\": 3}'"
      }
    },
    {
      "name": "get_pdf_info",
      "why": "The original handler reads the same upstream file through both surfaces.",
      "mcp": {
        "server": "pdf-tools",
        "tool": "get_pdf_info",
        "args": {
          "pdf_file_path": "${AGENT_WORKSPACE}/cv-gboeing.pdf"
        }
      },
      "mirage": {
        "command": "pdf-tools get-pdf-info '{\"pdf_file_path\": \"/workspace/cv-gboeing.pdf\"}'"
      }
    },
    {
      "name": "get_workbook_metadata",
      "why": "The original handler reads the same upstream file through both surfaces.",
      "mcp": {
        "server": "excel",
        "tool": "get_workbook_metadata",
        "args": {
          "filepath": "${AGENT_WORKSPACE}/exam.xlsx",
          "include_ranges": true
        }
      },
      "mirage": {
