{
  "note": "Both arms operate on the same directory -- the mirage /work mount is a disk mount of the agent workspace -- so this compares the two clients over one repository rather than two copies. The MCP server answers in prose; the CLI is git's own output.",
  "cases": [
    {
      "name": "log",
      "why": "the same commits, in the same order",
      "mcp": {
        "server": "git",
        "tool": "git_log",
        "args": {
          "repo_path": "${AGENT_WORKSPACE}/LUFFY",
          "max_count": 5
        },
        "pipe": "sed -n \"s/^Commit: '\\(.\\{7\\}\\).*/\\1/p\""
      },
      "mirage": {
        "command": "git -C /workspace/LUFFY log -n 5 --oneline",
        "pipe": "cut -d' ' -f1"
      }
    },
    {
      "name": "branch",
      "why": "the same branches, with the same one checked out",
      "mcp": {
        "server": "git",
        "tool": "git_branch",
        "args": {
          "repo_path": "${AGENT_WORKSPACE}/LUFFY",
          "branch_type": "local"
        },
        "pipe": "sed 's/^[* ] *//' | grep . | sort"
      },
      "mirage": {
        "command": "git -C /workspace/LUFFY branch",
        "pipe": "sed 's/^[* ] *//' | grep . | sort"
      }
    },
    {
      "name": "show",
      "why": "one commit's diff reads the same through either client",
      "mcp": {
        "server": "git",
        "tool": "git_show",
        "args": {
          "repo_path": "${AGENT_WORKSPACE}/LUFFY",
          "revision": "1937b6addce50565c710e6543d5531aa3ee70a4b"
        },
        "pipe": "grep -E '^[+-][^+-]' | sort"
      },
      "mirage": {
        "command": "git -C /workspace/LUFFY show 1937b6addce50565c710e6543d5531aa3ee70a4b",
        "pipe": "grep -E '^[+-][^+-]' | sort"
      }
    },
    {
      "name": "emails_get_folders",
      "why": "both arms list the same IMAP folders",
      "mcp": {
        "server": "emails",
        "tool": "get_folders",
        "args": {}
      },
      "mirage": {
        "command": "emails get-folders"
      }
    },
    {
      "name": "emails_get_emails",
      "why": "the same messages, in the same order, through either arm",
      "mcp": {
        "server": "emails",
        "tool": "get_emails",
        "args": {
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails get-emails '{\"folder\":\"INBOX\"}'"
      }
    },
    {
      "name": "emails_get_unread_count",
      "why": "the unread count agrees",
      "mcp": {
        "server": "emails",
        "tool": "get_unread_count",
        "args": {}
      },
      "mirage": {
        "command": "emails get-unread-count"
      }
    },
    {
      "name": "emails_get_mailbox_stats",
      "why": "the mailbox statistics agree",
      "mcp": {
        "server": "emails",
        "tool": "get_mailbox_stats",
        "args": {}
      },
      "mirage": {
        "command": "emails get-mailbox-stats"
      }
    },
    {
      "name": "emails_search_emails",
      "why": "a search returns the same hits",
      "mcp": {
        "server": "emails",
        "tool": "search_emails",
        "args": {
          "query": "the",
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails search-emails '{\"query\":\"the\",\"folder\":\"INBOX\"}'"
      }
    }
  ]
}
