      "payload": {
        "rich_text": [
          {
            "type": "text",
            "plain_text": "This comprehensive HR record serves as our central repository for managing all aspects of the 2025 Fall Application process. The page has been specifically designed to streamline our hiring workflow and provide transparent access to critical recruitment information for all stakeholders involved.",
