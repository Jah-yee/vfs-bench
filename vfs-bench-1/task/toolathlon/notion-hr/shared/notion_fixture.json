      "parent": "27ad10a4-8436-8035-b3bc-e9de9db3dd82",
      "type": "bulleted_list_item",
      "payload": {
        "rich_text": [
          {
            "type": "text",
            "plain_text": "Implementation of an advanced interview feedback system with structured evaluation templates to capture more meaningful insights about candidate suitability",
            "text": {
              "content": "Implementation of an advanced interview feedback system with structured evaluation templates to capture more meaningful insights about candidate suitability"
