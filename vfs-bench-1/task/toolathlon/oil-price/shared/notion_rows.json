      "position": 1,
      "type": "paragraph",
      "payloadJson": {
        "rich_text": [
          {
            "type": "text",
            "plain_text": "🧠 One-sentence explanation: Quantitative trading is the process of using code and mathematical models to replace human intuition and emotion in investment decision-making. It pursues rigorous and systematic trading, like conducting a scientific experiment.",
            "text": {
              "content": "🧠 One-sentence explanation: Quantitative trading is the process of using code and mathematical models to replace human intuition and emotion in investment decision-making. It pursues rigorous and systematic trading, like conducting a scientific experiment."
