{
  "cases": [
    {
      "name": "all-five-run-ids",
      "mcp": {
        "server": "wandb",
        "tool": "query_wandb_tool",
        "args": {
          "query": "query {project(entityName:\"mluo\",name:\"deepscaler-1.5b\"){runs(first:100){edges{node{id name displayName}} pageInfo{hasNextPage endCursor}}}}"
        },
        "jq": ".project.runs.edges | map(.node.name) | sort"
      },
      "mirage": {
        "command": "ls /wandb/mluo/deepscaler-1.5b",
        "pipe": "jq -Rsc 'split(\"\\n\") | map(select(length > 0)) | sort'"
      }
    },
    {
      "name": "2h1sn79d-history.jsonl",
      "mcp": {
        "server": "wandb",
        "tool": "query_wandb_tool",
        "args": {
          "query": "query {project(entityName:\"mluo\",name:\"deepscaler-1.5b\"){run(name:\"2h1sn79d\"){history(samples:2000)}}}"
        },
        "jq": ".project.run.history | map(fromjson)"
      },
      "mirage": {
        "command": "cat /wandb/mluo/deepscaler-1.5b/2h1sn79d/history.jsonl",
        "pipe": "jq -s ."
      }
    },
    {
      "name": "2h1sn79d-config.json",
      "mcp": {
        "server": "wandb",
        "tool": "query_wandb_tool",
        "args": {
          "query": "query {project(entityName:\"mluo\",name:\"deepscaler-1.5b\"){run(name:\"2h1sn79d\"){config}}}"
        },
        "jq": ".project.run.config | fromjson | with_entries(.value = .value.value)"
      },
      "mirage": {
        "command": "cat /wandb/mluo/deepscaler-1.5b/2h1sn79d/config.json"
      }
    },
