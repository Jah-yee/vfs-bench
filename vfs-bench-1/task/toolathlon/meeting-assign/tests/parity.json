{
  "note": "Tool-command cases call the same pinned handler down both arms, over the same fixture, so the replies are compared whole; a bespoke CLI answers in its own shape and is projected onto the same fact.",
  "cases": [
    {
      "name": "fetch_fetch_html",
      "why": "the raw body is identical through either arm",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_html",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "fetch html '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "fetch_fetch_txt",
      "why": "markup stripping agrees",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_txt",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "fetch txt '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "fetch_fetch_markdown",
      "why": "markdown conversion agrees",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_markdown",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "fetch markdown '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "fetch_fetch_json",
      "why": "the same URL parses to the same document",
      "mcp": {
        "server": "fetch",
        "tool": "fetch_json",
        "args": {
          "url": "https://api.github.com/repos/mojombo/grit"
        }
      },
      "mirage": {
        "command": "fetch json '{\"url\":\"https://api.github.com/repos/mojombo/grit\"}'"
      }
    },
    {
      "name": "emails_get_folders",
      "why": "both arms list the same IMAP folders",
      "mcp": {
        "server": "emails",
        "tool": "get_folders",
        "args": {}
      },
      "mirage": {
        "command": "emails get-folders"
      }
    },
    {
      "name": "emails_get_emails",
      "why": "the same messages, in the same order, through either arm",
      "mcp": {
        "server": "emails",
        "tool": "get_emails",
        "args": {
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails get-emails '{\"folder\":\"INBOX\"}'"
      }
    },
    {
      "name": "emails_get_unread_count",
      "why": "the unread count agrees",
      "mcp": {
        "server": "emails",
        "tool": "get_unread_count",
        "args": {}
      },
      "mirage": {
        "command": "emails get-unread-count"
      }
    },
    {
      "name": "emails_get_mailbox_stats",
      "why": "the mailbox statistics agree",
      "mcp": {
        "server": "emails",
        "tool": "get_mailbox_stats",
        "args": {}
      },
      "mirage": {
        "command": "emails get-mailbox-stats"
      }
    },
    {
      "name": "emails_search_emails",
      "why": "a search returns the same hits",
      "mcp": {
        "server": "emails",
        "tool": "search_emails",
        "args": {
          "query": "the",
          "folder": "INBOX"
        }
      },
      "mirage": {
        "command": "emails search-emails '{\"query\":\"the\",\"folder\":\"INBOX\"}'"
      }
    },
    {
      "name": "browser_navigate",
      "why": "navigating to the same page yields the same snapshot",
      "mcp": {
        "server": "playwright_with_chunk",
        "tool": "browser_navigate",
        "args": {
          "url": "https://example.com/"
        }
      },
      "mirage": {
        "command": "browser navigate '{\"url\":\"https://example.com/\"}'"
      }
    },
    {
      "name": "browser_tab_list",
      "why": "the open tabs agree after the same navigation",
      "mcp": {
        "server": "playwright_with_chunk",
        "tool": "browser_tab_list",
        "args": {}
      },
      "mirage": {
        "command": "browser tab-list"
      }
    }
  ]
}
