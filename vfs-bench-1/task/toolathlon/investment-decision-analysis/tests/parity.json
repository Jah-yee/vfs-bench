{
  "note": "yahoo-finance is read-only, so every case is read-only. The two surfaces are one-to-one by verb and answer in the same shape, so no case needs a projection.",
  "cases": [
    {
      "name": "stock_info",
      "why": "`get_stock_info` and `yahoo-finance get_stock_info` read the same fixture row",
      "mcp": {
        "server": "yahoo-finance",
        "tool": "get_stock_info",
        "args": {
          "ticker": "AAPL"
        }
      },
      "mirage": {
        "command": "yahoo-finance get-stock-info '{\"ticker\":\"AAPL\"}'"
      }
    },
    {
      "name": "historical_prices",
      "why": "`get_historical_stock_prices` and `yahoo-finance get_historical_stock_prices` read the same fixture row",
      "mcp": {
        "server": "yahoo-finance",
        "tool": "get_historical_stock_prices",
        "args": {
          "ticker": "AAPL",
          "period": "1mo",
          "interval": "1d"
        }
      },
      "mirage": {
        "command": "yahoo-finance get-historical-stock-prices '{\"ticker\":\"AAPL\",\"period\":\"1mo\",\"interval\":\"1d\"}'"
      }
    },
    {
      "name": "price_by_date",
      "why": "`get_stock_price_by_date` and `yahoo-finance get_stock_price_by_date` read the same fixture row",
      "mcp": {
        "server": "yahoo-finance",
        "tool": "get_stock_price_by_date",
        "args": {
          "ticker": "AAPL",
          "date": "2025-09-15"
        }
      },
      "mirage": {
        "command": "yahoo-finance get-stock-price-by-date '{\"ticker\":\"AAPL\",\"date\":\"2025-09-15\"}'"
      }
    },
