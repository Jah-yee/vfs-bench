    {
      "name": "drive_files_list",
      "why": "The CLI invokes the original Sheets folder-listing tool.",
      "mcp": {
        "server": "google_sheet",
        "tool": "list_folders",
        "args": {},
        "jq": ".name"
      },
      "mirage": {
        "command": "google-sheet list-folders '{}'",
        "jq": ".name"
      }
    },
    {
      "name": "create_spreadsheet_via_sheets",
      "why": "Both surfaces invoke the original spreadsheet creation handler.",
      "mutates": [
        "gws"
      ],
      "mcp": {
        "server": "google_sheet",
        "tool": "create_spreadsheet",
        "args": {
          "title": "Parity Check"
        },
        "jq": "{title: .title}"
      },
      "mirage": {
        "command": "google-sheet create-spreadsheet '{\"title\":\"Parity Check\"}'",
        "jq": "{title: .title}"
      }
    },
    {
      "name": "get_workbook_metadata",
      "why": "The pinned upstream handler reads the same task fixture through MCP and the workspace CLI.",
      "mcp": {
        "server": "excel",
        "tool": "get_workbook_metadata",
        "args": {
          "filepath": "${AGENT_WORKSPACE}/results.xlsx",
          "include_ranges": true
        }
      },
      "mirage": {
        "command": "excel get-workbook-metadata '{\"filepath\": \"/workspace/results.xlsx\", \"include_ranges\": true}'"
      }
    }
  ]
}
